erDiagram
    goods_receipts {
        uuid id PK
        varchar(30) receipt_number UK "NOT NULL"
        uuid po_revision_id FK
        uuid warehouse_id FK "NOT NULL"
        enum status "NOT NULL"
        timestamptz received_at "NOT NULL"
        uuid received_by "NOT NULL"
        timestamptz confirmed_at
        uuid confirmed_by
        varchar(100) delivery_note
        text note
        timestamptz closed_at
        timestamptz approval_requested_at
        uuid approval_requested_by
        enum approval_decision
        timestamptz approval_decided_at
        uuid approval_decided_by
        varchar(500) approval_reason
        uuid supplier_id FK
        varchar(500) blind_reason
        uuid referenced_po_id FK
    }
    categories {
        uuid id PK
        uuid parent_id FK
        varchar(50) code UK "NOT NULL"
        varchar(255) name "NOT NULL"
        varchar(255) slug UK "NOT NULL"
        text path "NOT NULL"
        int depth "NOT NULL"
        int sort_order "NOT NULL"
        text image_url
        varchar(255) seo_title
        text seo_description
        boolean is_active "NOT NULL"
    }
    purchase_orders {
        uuid id PK
        varchar(30) po_number UK "NOT NULL"
        bigint revision_no "NOT NULL"
        enum status "NOT NULL"
        uuid supplier_id FK "NOT NULL"
        uuid warehouse_id FK "NOT NULL"
        varchar(3) currency "NOT NULL"
        date order_date "NOT NULL"
        date expected_date
        varchar(50) payment_terms
        varchar(10) incoterms
        decimal subtotal "decimal(18,2), NOT NULL"
        decimal discount_total "decimal(18,2), NOT NULL"
        decimal tax_total "decimal(18,2), NOT NULL"
        decimal shipping_fee "decimal(18,2), NOT NULL"
        decimal total_amount "decimal(18,2), NOT NULL"
        uuid active_revision_id FK
        uuid pending_revision_id FK
        uuid source_proposal_id FK
        text note
        enum close_kind
        varchar(255) close_reason
        varchar(255) cancel_reason
        timestamptz submitted_at
        uuid submitted_by
        timestamptz approved_at
        uuid approved_by
        timestamptz confirmed_at
        uuid confirmed_by
        timestamptz closed_at
        uuid closed_by
        enum po_type "NOT NULL"
        uuid production_order_id FK
        int payment_term_days "NOT NULL"
        int lead_time_days "NOT NULL"
        enum supplier_confirmation_status "NOT NULL"
        timestamptz supplier_responded_at
        varchar(100) supplier_reference
        varchar(1000) supplier_response_note
        boolean auto_approved "NOT NULL"
    }
    product_categories {
        uuid id PK
        uuid product_id FK "NOT NULL"
        uuid category_id FK "NOT NULL"
        boolean is_primary "NOT NULL"
    }
    warehouse {
        uuid id PK
        varchar(200) name "NOT NULL"
    }
    products {
        uuid id PK
        uuid brand_id FK
        varchar(50) code UK "NOT NULL"
        varchar(255) name "NOT NULL"
        varchar(300) name_en
        varchar(255) slug UK "NOT NULL"
        text short_description
        text description
        text description_en
        enum tax_class
        enum kind "NOT NULL"
        enum status "NOT NULL"
        text rejection_reason
        varchar(255) seo_title
        text seo_description
        uuid submitted_by
        timestamptz submitted_at
        uuid approved_by
        timestamptz approved_at
        timestamptz published_at
        timestamptz discontinued_at
        boolean ever_published "NOT NULL"
        varchar(500) discontinue_reason
        timestamptz suspended_at
        varchar(500) suspend_reason
        boolean self_approved "NOT NULL"
    }
    production_order {
        uuid id PK
        varchar(30) order_number UK "NOT NULL"
    }
    brands {
        uuid id PK
        varchar(50) code UK "NOT NULL"
        varchar(255) name "NOT NULL"
    }
    replenishment_proposals {
        uuid id PK
        varchar(30) code UK "NOT NULL"
        uuid warehouse_id FK "NOT NULL"
        enum status "NOT NULL"
        enum origin "NOT NULL"
        date run_date "NOT NULL"
        uuid reviewed_by
        timestamptz reviewed_at
        uuid converted_by
        timestamptz converted_at
        text note
    }
    supplier_invoices {
        uuid id PK
        varchar(64) invoice_number "NOT NULL"
        uuid supplier_id FK "NOT NULL"
        uuid po_id FK
        enum status "NOT NULL"
        varchar(3) currency "NOT NULL"
        date invoice_date "NOT NULL"
        date due_date
        decimal subtotal "decimal(18,2), NOT NULL"
        decimal tax_total "decimal(18,2), NOT NULL"
        decimal total_amount "decimal(18,2), NOT NULL"
        text file_url
        uuid received_by
        varchar(500) note
        varchar(255) file_name
        varchar(100) file_content_type
        timestamptz matched_at
        uuid matched_by
        decimal price_tolerance_percent "decimal(5,2)"
        timestamptz voided_at
        uuid voided_by
        varchar(500) void_reason
    }
    suppliers {
        uuid id PK
        varchar(30) code UK "NOT NULL"
        varchar(200) name "NOT NULL"
        varchar(200) legal_name
        varchar(30) tax_id
        enum status "NOT NULL"
        varchar(3) currency "NOT NULL"
        varchar(50) payment_terms
        varchar(10) incoterms
        decimal over_receipt_tolerance "decimal(5,2)"
        int lead_time_days
        varchar(200) bank_account_name
        varchar(50) bank_account_number
        varchar(150) bank_name
        text note
        boolean is_print_subcontractor "NOT NULL"
        decimal loss_tolerance_percent "decimal(5,2), NOT NULL"
        int payment_term_days "NOT NULL"
        enum communication_channel "NOT NULL"
        varchar(500) api_endpoint
    }
    purchase_order_revisions {
        uuid id PK
        uuid po_id FK "NOT NULL"
        bigint revision_no "NOT NULL"
        enum kind "NOT NULL"
        jsonb snapshot_header "NOT NULL"
        varchar(500) change_summary
        timestamptz changed_at "NOT NULL"
        uuid changed_by "NOT NULL"
    }
    variants {
        uuid id PK
        uuid product_id FK "NOT NULL"
        varchar(64) sku UK "NOT NULL"
        varchar(255) name "NOT NULL"
        enum status "NOT NULL"
        boolean is_default "NOT NULL"
        varchar(512) attribute_signature "NOT NULL"
        int position "NOT NULL"
        timestamptz obsoleted_at
    }
    purchase_order_approvals {
        uuid id PK
        uuid po_revision_id FK "NOT NULL"
        int step_no "NOT NULL"
        uuid approver_id "NOT NULL"
        enum decision "NOT NULL"
        timestamptz decision_at "NOT NULL"
        varchar(500) reason
        uuid limit_id
        decimal limit_amount "decimal(18,2)"
        uuid limit_role_id
        uuid limit_holder_id
    }
    goods_receipt_lines {
        uuid id PK
        uuid receipt_id FK "NOT NULL"
        uuid po_line_id FK
        uuid inventory_item_id FK "NOT NULL"
        uuid location_id FK "NOT NULL"
        decimal received_qty "decimal(18,3), NOT NULL"
        varchar(64) lot_number
        date expiry_date
        varchar(255) note
        boolean qc_required "NOT NULL"
        uuid qc_location_id FK
        timestamptz moved_to_qc_at
        uuid moved_to_qc_by
        uuid uom_conversion_id FK
    }
    supplier_invoice_lines {
        uuid id PK
        uuid invoice_id FK "NOT NULL"
        uuid po_line_id FK "NOT NULL"
        uuid receipt_line_id FK
        decimal invoiced_qty "decimal(18,3), NOT NULL"
        decimal unit_price "decimal(18,2), NOT NULL"
        decimal tax_rate "decimal(5,2), NOT NULL"
        decimal line_total "decimal(18,2), NOT NULL"
    }
    supplier_items {
        uuid id PK
        uuid supplier_id FK "NOT NULL"
        uuid inventory_item_id FK "NOT NULL"
        varchar(50) supplier_sku_code
        decimal current_price "decimal(18,2), NOT NULL"
        varchar(3) currency "NOT NULL"
        int moq "NOT NULL"
        int pack_size "NOT NULL"
        int lead_time_days
    }
    inventory_items {
        uuid id PK
        varchar(64) sku FK, UK "NOT NULL"
        varchar(16) unit_of_measure "NOT NULL"
        varchar(64) barcode
        decimal weight_kg "decimal(10,3)"
        decimal length_cm "decimal(10,2)"
        decimal width_cm "decimal(10,2)"
        decimal height_cm "decimal(10,2)"
        decimal package_weight_kg "decimal(10,3)"
        decimal package_length_cm "decimal(10,2)"
        decimal package_width_cm "decimal(10,2)"
        decimal package_height_cm "decimal(10,2)"
        int package_count "NOT NULL"
        int pack_size "NOT NULL"
        enum storage_class "NOT NULL"
        boolean lot_tracked "NOT NULL"
        boolean expiry_tracked "NOT NULL"
        boolean serial_tracked "NOT NULL"
        int max_qty
        int reorder_point
        uuid default_supplier_id FK
        boolean requires_adult_signature "NOT NULL"
        varchar(500) shipping_restriction_note
        boolean qc_required "NOT NULL"
        int safety_stock
        enum removal_strategy "NOT NULL"
        int max_shelf_life_days
        boolean policy_configured "NOT NULL"
        boolean rotatable "NOT NULL"
        decimal reference_purchase_price "decimal(18,2)"
        varchar(3) reference_purchase_currency
        int lead_time_days
        int moq
    }
    supplier_invoice_variances {
        uuid id PK
        uuid invoice_id FK "NOT NULL"
        uuid invoice_line_id FK
        uuid po_id FK
        enum kind "NOT NULL"
        decimal expected_value "decimal(18,3), NOT NULL"
        decimal invoiced_value "decimal(18,3), NOT NULL"
        decimal variance_amount "decimal(18,2), NOT NULL"
    }
    purchase_order_lines {
        uuid id PK
        uuid po_id FK "NOT NULL"
        uuid po_revision_id FK
        int line_no "NOT NULL"
        uuid inventory_item_id FK "NOT NULL"
        varchar(20) uom "NOT NULL"
        decimal ordered_qty "decimal(18,3), NOT NULL"
        decimal unit_price "decimal(18,2), NOT NULL"
        decimal tax_rate "decimal(5,2), NOT NULL"
        decimal discount_rate "decimal(5,2), NOT NULL"
        decimal line_subtotal "decimal(18,2), NOT NULL"
        decimal line_discount_amount "decimal(18,2), NOT NULL"
        decimal line_net "decimal(18,2), NOT NULL"
        decimal line_tax "decimal(18,2), NOT NULL"
        decimal line_total "decimal(18,2), NOT NULL"
        enum status "NOT NULL"
        varchar(255) note
        uuid uom_conversion_id FK
        int unit_qty
    }
    storage_location {
        uuid id PK
        varchar(64) location_code UK "NOT NULL"
    }
    qc_inspections {
        uuid id PK
        uuid receipt_line_id FK "NOT NULL"
        enum outcome "NOT NULL"
        decimal quantity "decimal(18,3), NOT NULL"
        uuid target_location_id FK
        varchar(500) reason
        uuid inspected_by "NOT NULL"
        timestamptz inspected_at "NOT NULL"
    }
    uom_conversions {
        uuid id PK
        uuid inventory_item_id FK "NOT NULL"
        varchar(16) unit_of_measure "NOT NULL"
        int factor "NOT NULL"
        boolean is_base "NOT NULL"
        decimal weight_kg "decimal(10,3)"
        decimal length_cm "decimal(10,2)"
        decimal width_cm "decimal(10,2)"
        decimal height_cm "decimal(10,2)"
        boolean default_purchase "NOT NULL"
        boolean active "NOT NULL"
        boolean default_shipping "NOT NULL"
    }

    brands |o--o{ products : "brand_id"
    categories |o--o{ categories : "parent_id"
    categories ||--o{ product_categories : "category_id"
    goods_receipt_lines |o--o{ supplier_invoice_lines : "receipt_line_id"
    goods_receipt_lines ||--o{ qc_inspections : "receipt_line_id"
    goods_receipts ||--o{ goods_receipt_lines : "receipt_id"
    inventory_items ||--o{ goods_receipt_lines : "inventory_item_id"
    inventory_items ||--o{ purchase_order_lines : "inventory_item_id"
    inventory_items ||--o{ supplier_items : "inventory_item_id"
    inventory_items ||--o{ uom_conversions : "inventory_item_id"
    production_order |o--o{ purchase_orders : "production_order_id"
    products ||--o{ product_categories : "product_id"
    products ||--o{ variants : "product_id"
    purchase_order_lines |o--o{ goods_receipt_lines : "po_line_id"
    purchase_order_lines ||--o{ supplier_invoice_lines : "po_line_id"
    purchase_order_revisions |o--o{ goods_receipts : "po_revision_id"
    purchase_order_revisions |o--o{ purchase_order_lines : "po_revision_id"
    purchase_order_revisions |o--o{ purchase_orders : "active_revision_id"
    purchase_order_revisions |o--o{ purchase_orders : "pending_revision_id"
    purchase_order_revisions ||--o{ purchase_order_approvals : "po_revision_id"
    purchase_orders |o--o{ goods_receipts : "referenced_po_id"
    purchase_orders |o--o{ supplier_invoice_variances : "po_id"
    purchase_orders |o--o{ supplier_invoices : "po_id"
    purchase_orders ||--o{ purchase_order_lines : "po_id"
    purchase_orders ||--o{ purchase_order_revisions : "po_id"
    replenishment_proposals |o--o{ purchase_orders : "source_proposal_id"
    storage_location |o--o{ goods_receipt_lines : "qc_location_id"
    storage_location |o--o{ qc_inspections : "target_location_id"
    storage_location ||--o{ goods_receipt_lines : "location_id"
    supplier_invoice_lines |o--o{ supplier_invoice_variances : "invoice_line_id"
    supplier_invoices ||--o{ supplier_invoice_lines : "invoice_id"
    supplier_invoices ||--o{ supplier_invoice_variances : "invoice_id"
    suppliers |o--o{ goods_receipts : "supplier_id"
    suppliers |o--o{ inventory_items : "default_supplier_id"
    suppliers ||--o{ purchase_orders : "supplier_id"
    suppliers ||--o{ supplier_invoices : "supplier_id"
    suppliers ||--o{ supplier_items : "supplier_id"
    uom_conversions |o--o{ goods_receipt_lines : "uom_conversion_id"
    uom_conversions |o--o{ purchase_order_lines : "uom_conversion_id"
    variants ||--o| inventory_items : "sku"
    warehouse ||--o{ goods_receipts : "warehouse_id"
    warehouse ||--o{ purchase_orders : "warehouse_id"
    warehouse ||--o{ replenishment_proposals : "warehouse_id"
